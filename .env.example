# Copy to .env.local (git-ignored) and fill in real values.
WHOP_API_KEY=
WHOP_WEBHOOK_SECRET=
NEXT_PUBLIC_WHOP_APP_ID=
# Optional: point the clip API somewhere other than the local Clipping AI backend
CLIPPINGAI_API_URL=
WHOP_API_BASE=
WHOP_API_VERSION_DATE=

# ── Upload-Post: include it in the plan (managed mode) ─────────────────────
# OFF by default. With managed mode the server holds ONE Upload-Post account
# and gives each Whop user their own profile inside it, so the publishing pages
# work without a pasted key. Do not enable until:
#   1. Upload-Post has agreed a reseller / white-label arrangement in writing
#      (their ToS forbids reselling API access otherwise), and
#   2. the x-whop-user-token is verified against Whop's JWKS.
# UPLOAD_POST_MANAGED_ENABLED=1
# UPLOAD_POST_MANAGED_API_KEY=api-key-of-the-shared-account
# Pin a single profile for single-tenant use; empty derives wa_<whop user id>.
# UPLOAD_POST_MANAGED_PROFILE=
# Entitlement gate: when set, the caller must hold access to this experience
# (exp_…) before a managed profile is provisioned. Empty = any verified Whop
# user is entitled (fine for a single paid community).
# UPLOAD_POST_ENTITLEMENT_EXPERIENCE_ID=
